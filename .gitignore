# ESP-IDF output, and the sdkconfig it derives from sdkconfig.defaults: committing that would make a
# second source of truth that silently wins over the defaults file. (espnow-rssi ignores its own.)
firmware/espnow-c/build/
firmware/espnow-c/sdkconfig
firmware/espnow-c/sdkconfig.old

__pycache__/
*.pyc

# Rendered and sliced output: build products, made again from the .scad sources whenever needed.
*.stl
*.3mf
*.gcode

# The one-file parts scad-tools/scripts/printables.py makes for Printables, from the sources.
/printables/

# OpenSCAD Customizer parameter sets: a second source of truth that only the GUI reads.
*.json

# The airflow simulation's generated cases and their results, and its environment.
sim/lunchbox-cfd/cases/
.venv/
# ...but the airflow results the build page quotes are evidence, kept beside their pictures.
!docs/lunchbox/cfd/*.json
